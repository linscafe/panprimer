// Nextflow config. `local` uses the conda env; `container` is the cloud-scale path
// (build an image from env/environment.yml). Select with `-profile`.
//
// Execution profiles (local/container/test) and SIZING profiles (laptop16/server64/
// server256/bigmem) are independent — combine them: `-profile local,server256`.
// Everything they set is a plain param, so `--scan_threads 8` on the command line still
// wins. See docs/sizing.md.

params {
    target   = null            // 'chr:start-end' on CHM13, or a FASTA path
    chm13    = null            // CHM13 v2.0 FASTA (indexed)
    samples  = 'config/samples.tsv'
    config   = 'config/defaults.yaml'
    mode     = null            // thermo | rule (default: from config)
    top_k    = 5               // genome-wide specificity (stage B) on the top-K by coverage
    target_assembly = 'chm13'  // coordinate system of a chr:start-end --target (chm13|grch38)
    grch38   = null            // GRCh38 FASTA, required when target_assembly = grch38
    outdir   = 'results'

    // ---- resources -------------------------------------------------------------------
    // Defaults are tuned for a 16-core / 16 GB laptop and are NOT right for a big host.
    // Pick a sizing profile or override individually. docs/sizing.md has the measured
    // curves and a sweep script for re-measuring on your own machine.
    scan_threads   = 4         // threads per EVALUATE task; also exported as PGP_SCAN_THREADS
    scan_memory    = '2 GB'    // peak RSS of a scan is ~400 MB at any thread count
    project_memory = '2 GB'    // ~4 MB anchor grid; headroom for the .mmi fallback path
    grid_threads   = 4         // minimap2 -t for anchor-grid builds (RAM-bound, ~8.3 GB/build)
}

profiles {
    local {
        process.conda = "${projectDir}/env/environment.yml"
        conda.enabled = true
        process.executor = 'local'
    }
    container {
        process.container = 'pangenome-primer:latest'   // built from env/environment.yml
        docker.enabled = true
    }
    test {
        // synthetic mini-pangenome; assumes `pangenome-primer` already on PATH
        process.executor = 'local'
    }

    // ---- sizing profiles ---------------------------------------------------------------
    // Rule behind all of them: threads x concurrent-tasks ~= core count, threads in 2-4.
    // With the local executor, declaring `cpus` is what enforces the concurrency half --
    // Nextflow will not start more EVALUATE tasks than the declared cpus allow, so the
    // product is bounded by construction rather than by remembering to set two knobs.

    // 16 cores / 16 GB. Measured optimum: 4 threads x 4 concurrent, 19% faster than
    // letting each task take all 16 cores.
    laptop16 {
        params.scan_threads = 4
        params.grid_threads = 4      // ~8.3 GB peak: ONE grid build at a time on 16 GB
    }

    // ~64 cores / 256 GB. Same per-task shape, 16 tasks in flight instead of 4.
    server64 {
        params.scan_threads = 4
        params.grid_threads = 8
    }

    // ~256 cores / 700 GB. Never give one scan 256 threads: parallel efficiency is already
    // 21% at 16. 4 x 64 keeps every core busy on useful work.
    server256 {
        params.scan_threads = 4
        params.grid_threads = 8
    }

    // Plenty of RAM, few cores, or a shared host where you want fewer, fatter tasks.
    bigmem {
        params.scan_threads = 8
        params.scan_memory  = '4 GB'
        params.grid_threads = 16
    }
}

// Per-process resources. These are also what the scanner sizes itself from: EVALUATE exports
// PGP_SCAN_THREADS=${task.cpus}, so `cpus` here is the real knob for scan parallelism, and
// threads x concurrent-tasks stays within the allocation by construction.
process {
    cpus = 2
    memory = '4 GB'
    // Projection reads a ~4 MB sparse anchor grid, not the 5.80 GB per-haplotype .mmi it
    // used to build (see docs/scanner_notes.md and scripts/prepare_haplotypes.sh). The 8 GB
    // reservation that went with the .mmi is long dead.
    withName: PROJECT   { cpus = 1; memory = params.project_memory }
    withName: STAGE_A   { cpus = 1 }                     // cheap; window sequences only
    // Genome-wide scan per haplotype. Peak RSS is ~400 MB at every thread count -- the
    // scanner streams the BGZF and holds no index -- so memory is not the constraint; CPU
    // efficiency is. RE-MEASURE on a many-core host before raising scan_threads:
    // docs/sizing.md ships a sweep script, ISSUE-002 in docs/scanner_notes.md has the laptop curve.
    withName: EVALUATE  { cpus = params.scan_threads; memory = params.scan_memory }
}
